# Local development defaults
PORT=3001
NODE_ENV=development
PUBLIC_SITE_ORIGIN=http://localhost:5173
DASHBOARD_ORIGIN=http://localhost:5174
ADDITIONAL_ALLOWED_ORIGINS=
JWT_EXPIRES_IN=24h
ALLOW_REMOTE_DB=false

# Required secrets/configuration
# Do not commit real values. Configure production values in the hosting provider.
JWT_SECRET=<set-a-strong-secret-in-hosting>
MONGODB_URI=mongodb://localhost:27017/fortune-construction

# Production guidance
# PUBLIC_SITE_ORIGIN=https://fortuneconstruction.net
# DASHBOARD_ORIGIN=https://<dashboard-domain>
# ADDITIONAL_ALLOWED_ORIGINS=https://<optional-approved-origin>
# MONGODB_URI=<redacted-production-mongodb-uri>
# JWT_SECRET=<redacted-strong-production-secret>
